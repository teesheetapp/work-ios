{
  "appId": "com.workliftlog.app",
  "appName": "WORK",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a0b0d",
    "scrollEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 400,
      "launchAutoHide": true,
      "backgroundColor": "#0a0b0d",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    }
  }
}
